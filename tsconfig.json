{
  "compilerOptions": {
    "types": ["node"],
    "lib": ["es2022"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "target": "es2022",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "interfaces/**/*.ts"]
}
